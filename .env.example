# Copy to .env. Leave integrations blank until ready. Never share this file.
HOST=127.0.0.1
PORT=3000
DATA_PATH=data/tracker.sqlite
# Exact website origin (no trailing slash). Register the callback URLs in SETUP.md.
PUBLIC_ORIGIN=http://127.0.0.1:3000

DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
# Enables website server/channel setup (not the bot token):
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Optional test server ID for faster command registration:
DISCORD_TEST_GUILD=

# User OAuth token for the bot account, with user:read:chat user:write:chat.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=
TWITCH_BOT_USER_ID=
# Comma-separated broadcaster user IDs. Enable only in channels whose owners consent.
TWITCH_CHANNEL_IDS=

# Optional YouTube Live connector. OAuth scope: youtube.force-ssl.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_BOT_CHANNEL_ID=
# These are live chat IDs, not channel IDs or video IDs.
YOUTUBE_LIVE_CHAT_IDS=
